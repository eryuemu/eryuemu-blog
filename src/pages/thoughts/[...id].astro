---
import BaseHead from '../../components/BaseHead.astro';
import Header from '../../components/Header.astro';
import Footer from '../../components/Footer.astro';
import WalineComments from '../../components/WalineComments.astro';
import FormattedDate from '../../components/FormattedDate.astro';
import { SITE_TITLE } from '../../consts';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
	const rawThoughts = await getCollection('thoughts');
	// 按照发布时间倒序排列（最新的在最前）
	const thoughts = rawThoughts.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());

	return thoughts.map((thought, index) => {
		const prevThought = index < thoughts.length - 1 ? thoughts[index + 1] : null; // 较旧的
		const nextThought = index > 0 ? thoughts[index - 1] : null; // 较新的
		
		const currentTags = thought.data.tags || [];
		const relatedThoughts = thoughts
			.filter(t => t.id !== thought.id && t.data.tags?.some(tag => currentTags.includes(tag)))
			.slice(0, 2);

		return {
			params: { id: thought.id },
			props: { 
				thought, 
				prevThought, 
				nextThought,
				relatedThoughts,
			},
		};
	});
}

const { thought, prevThought, nextThought, relatedThoughts = [] } = Astro.props;
const { Content } = await render(thought);
const { pubDate, tags = [], location, mood, images = [], pinned } = thought.data;
const gridClass = `grid-${Math.min(images.length, 9)}`;

// 动态提取心迹文本内容生成独特的 SEO Title 与 Description
const rawBody = thought.body || '';
const cleanText = rawBody.replace(/[\s\r\n#*`_>[\]()\-+!]+/g, ' ').trim();
const seoTitle = cleanText 
	? `心迹: “${cleanText.slice(0, 32)}${cleanText.length > 32 ? '...' : ''}” — ${SITE_TITLE}`
	: `心迹动态 (${thought.id}) — ${SITE_TITLE}`;
const seoDescription = cleanText 
	? cleanText.slice(0, 140) 
	: `eryuemu（二月木）于 ${pubDate.toISOString().slice(0, 10)} 发布的心迹动态`;

// 辅助提取前后篇预览文本
const getPreviewText = (body?: string) => {
	if (!body) return '';
	const clean = body.replace(/[\s\r\n#*`_>[\]()\-+!]+/g, ' ').trim();
	return clean.slice(0, 45) + (clean.length > 45 ? '...' : '');
};
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead
			title={seoTitle}
			description={seoDescription}
		/>

		<!-- 独立心迹 SocialMediaPosting 结构化数据，辅助搜索引擎建立独立实体索引 -->
		<script type="application/ld+json" set:html={JSON.stringify({
			"@context": "https://schema.org",
			"@type": "SocialMediaPosting",
			"url": new URL(Astro.url.pathname, Astro.site).href,
			"headline": seoTitle,
			"articleBody": cleanText,
			"datePublished": pubDate.toISOString(),
			"dateModified": pubDate.toISOString(),
			"inLanguage": "zh-CN",
			...(images && images.length > 0 ? { "image": images.map((img: string) => new URL(img, Astro.site).href) } : {}),
			"author": {
				"@type": "Person",
				"name": "eryuemu",
				"url": "https://eryuemu.com/about"
			},
			"publisher": {
				"@type": "Organization",
				"name": SITE_TITLE,
				"url": "https://eryuemu.com"
			},
			"mainEntityOfPage": {
				"@type": "WebPage",
				"@id": new URL(Astro.url.pathname, Astro.site).href
			}
		})} />

		<style>
			main {
				max-width: 740px;
				margin: 0 auto;
				padding-top: 6rem;
				padding-bottom: 4rem;
			}

			.back-link {
				display: inline-flex;
				align-items: center;
				gap: 0.4rem;
				font-size: 0.88rem;
				color: var(--text-secondary);
				margin-bottom: 1.5rem;
				text-decoration: none;
				transition: color 0.2s ease;
			}

			.back-link:hover {
				color: var(--text-primary);
			}

			.thought-card {
				background: var(--bg);
				border: 1px solid var(--border);
				border-radius: var(--radius, 12px);
				padding: 1.5rem;
				position: relative;
				margin-bottom: 1.5rem;
			}

			.card-header {
				display: flex;
				align-items: center;
				justify-content: space-between;
				margin-bottom: 1rem;
			}

			.author-box {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.card-avatar {
				width: 42px;
				height: 42px;
				border-radius: 50%;
				object-fit: cover;
				background: var(--bg-secondary);
				border: 1px solid var(--border);
			}

			.author-name {
				font-size: 0.95rem;
				font-weight: 600;
				color: var(--text-primary);
				margin: 0;
				line-height: 1.2;
			}

			.post-time {
				font-size: 0.78rem;
				color: var(--text-muted);
			}

			.thought-body {
				font-size: 1rem;
				line-height: 1.7;
				color: var(--text-primary);
				margin-bottom: 1rem;
			}

			.image-grid {
				display: grid;
				gap: 0.5rem;
				margin-top: 0.8rem;
				margin-bottom: 0.8rem;
				border-radius: 8px;
				overflow: hidden;
			}

			.image-grid.grid-1 {
				grid-template-columns: 1fr;
				max-width: 480px;
			}
			.image-grid.grid-2, .image-grid.grid-4 {
				grid-template-columns: repeat(2, 1fr);
				max-width: 480px;
			}
			.image-grid.grid-3, .image-grid.grid-5, .image-grid.grid-6, .image-grid.grid-7, .image-grid.grid-8, .image-grid.grid-9 {
				grid-template-columns: repeat(3, 1fr);
				max-width: 520px;
			}

			.grid-img {
				width: 100%;
				aspect-ratio: 1 / 1;
				object-fit: cover;
				border-radius: 6px;
				cursor: zoom-in;
				background: var(--bg-secondary);
				border: 1px solid var(--border);
			}

			.card-footer {
				display: flex;
				align-items: center;
				justify-content: space-between;
				padding-top: 0.8rem;
				border-top: 1px dashed var(--border);
				font-size: 0.82rem;
				color: var(--text-muted);
			}

			.location-tag {
				display: flex;
				align-items: center;
				gap: 0.3rem;
			}

			.tags-list {
				display: flex;
				gap: 0.35rem;
			}

			.tag-item {
				font-size: 0.75rem;
				color: var(--text-secondary);
				background: var(--bg-secondary);
				padding: 0.1rem 0.45rem;
				border-radius: 4px;
				border: 1px solid var(--border);
				text-decoration: none;
			}

			/* ─── 前后篇导航卡片 ─── */
			.thought-navigation {
				display: grid;
				grid-template-columns: 1fr 1fr;
				gap: 1rem;
				margin-bottom: 2rem;
			}

			.nav-card {
				display: flex;
				flex-direction: column;
				gap: 0.35rem;
				padding: 0.9rem 1.1rem;
				background: var(--bg);
				border: 1px solid var(--border);
				border-radius: var(--radius, 10px);
				text-decoration: none;
				transition: border-color 0.2s ease, transform 0.2s ease;
			}

			.nav-card:hover {
				border-color: var(--border-hover);
				transform: translateY(-1px);
			}

			.nav-card.prev {
				text-align: left;
			}

			.nav-card.next {
				text-align: right;
			}

			.nav-direction {
				font-size: 0.75rem;
				font-weight: 600;
				color: var(--text-muted);
				text-transform: uppercase;
				letter-spacing: 0.03em;
				display: flex;
				align-items: center;
				gap: 0.3rem;
			}

			.nav-card.next .nav-direction {
				justify-content: flex-end;
			}

			.nav-title {
				font-size: 0.88rem;
				color: var(--text-primary);
				line-height: 1.4;
				overflow: hidden;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
			}

			/* ─── 同标签关联心迹 ─── */
			.related-section {
				background: var(--bg);
				border: 1px solid var(--border);
				border-radius: var(--radius, 12px);
				padding: 1.25rem 1.4rem;
				margin-bottom: 2rem;
			}

			.related-title {
				font-size: 0.88rem;
				font-weight: 600;
				color: var(--text-primary);
				margin: 0 0 0.8rem 0;
				display: flex;
				align-items: center;
				gap: 0.4rem;
			}

			.related-list {
				display: flex;
				flex-direction: column;
				gap: 0.75rem;
			}

			.related-item {
				display: flex;
				justify-content: space-between;
				align-items: center;
				padding: 0.6rem 0.8rem;
				border-radius: 6px;
				background: var(--bg-secondary);
				border: 1px solid var(--border);
				text-decoration: none;
				transition: border-color 0.2s ease;
			}

			.related-item:hover {
				border-color: var(--border-hover);
			}

			.related-text {
				font-size: 0.85rem;
				color: var(--text-primary);
				flex: 1;
				margin-right: 0.8rem;
				white-space: nowrap;
				overflow: hidden;
				text-overflow: ellipsis;
			}

			.related-date {
				font-size: 0.75rem;
				color: var(--text-muted);
				flex-shrink: 0;
			}

			@media (max-width: 640px) {
				.thought-navigation {
					grid-template-columns: 1fr;
				}
				.nav-card.next {
					text-align: left;
				}
				.nav-card.next .nav-direction {
					justify-content: flex-start;
				}
			}
		</style>
	</head>
	<body>
		<Header />
		<main>
			<a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/thoughts/`} class="back-link">
				<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
					<line x1="19" y1="12" x2="5" y2="12"></line>
					<polyline points="12 19 5 12 12 5"></polyline>
				</svg>
				返回心迹列表
			</a>

			<article class="thought-card">
				<div class="card-header">
					<div class="author-box">
						<img
							src="/avatar.jpg"
							alt="eryuemu"
							class="card-avatar"
							onerror="this.onerror=null; this.src='data:image/svg+xml,<svg xmlns=%22http://www.w3.org/2000/svg%22 viewBox=%220 0 100 100%22><rect width=%22100%22 height=%22100%22 fill=%22%23222%22/><circle cx=%2250%22 cy=%2238%22 r=%2220%22 fill=%22%23666%22/><path d=%22M20 85c0-20 15-30 30-30s30 10 30 30z%22 fill=%22%23666%22/></svg>';"
						/>
						<div>
							<h3 class="author-name">eryuemu</h3>
							<div class="post-time">
								<FormattedDate date={pubDate} includeTime={true} />
							</div>
						</div>
					</div>

					{mood && (
						<div class="location-tag">
							<span>{mood}</span>
						</div>
					)}
				</div>

				<div class="thought-body prose">
					<Content />
				</div>

				{images && images.length > 0 && (
					<div class={`image-grid ${gridClass}`}>
						{images.map((imgUrl: string, idx: number) => (
							<img
								src={imgUrl}
								alt={`Dynamic image ${idx + 1}`}
								class="grid-img"
								loading="lazy"
							/>
						))}
					</div>
				)}

				{(location || (tags && tags.length > 0)) && (
					<div class="card-footer">
						<div class="location-tag">
							{location && (
								<>
									<svg width="13" height="13" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
										<path d="M20 10c0 6-8 12-8 12s-8-6-8-12a8 8 0 0 1 16 0Z"></path>
										<circle cx="12" cy="10" r="3"></circle>
									</svg>
									<span>{location}</span>
								</>
							)}
						</div>

						{tags && tags.length > 0 && (
							<div class="tags-list">
								{tags.map((tag: string) => (
									<span class="tag-item">#{tag}</span>
								))}
							</div>
						)}
					</div>
				)}
			</article>

			<!-- 前后心迹导航条（增加内链互通与内容实体厚度） -->
			<div class="thought-navigation">
				{prevThought ? (
					<a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/thoughts/${prevThought.id}/`} class="nav-card prev">
						<span class="nav-direction">
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="15 18 9 12 15 6"></polyline>
							</svg>
							上一条心迹
						</span>
						<span class="nav-title">{getPreviewText(prevThought.body)}</span>
					</a>
				) : (
					<div />
				)}

				{nextThought ? (
					<a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/thoughts/${nextThought.id}/`} class="nav-card next">
						<span class="nav-direction">
							下一条心迹
							<svg width="12" height="12" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
								<polyline points="9 18 15 12 9 6"></polyline>
							</svg>
						</span>
						<span class="nav-title">{getPreviewText(nextThought.body)}</span>
					</a>
				) : (
					<div />
				)}
			</div>

			<!-- 同标签关联动态（如有） -->
			{relatedThoughts.length > 0 && (
				<section class="related-section">
					<h4 class="related-title">
						<svg width="14" height="14" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
							<path d="M20.59 13.41l-7.17 7.17a2 2 0 0 1-2.83 0L2 12V2h10l8.59 8.59a2 2 0 0 1 0 2.82z"></path>
							<line x1="7" y1="7" x2="7.01" y2="7"></line>
						</svg>
						同标签相关心迹
					</h4>
					<div class="related-list">
						{relatedThoughts.map((item) => (
							<a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/thoughts/${item.id}/`} class="related-item">
								<span class="related-text">{getPreviewText(item.body)}</span>
								<span class="related-date">
									<FormattedDate date={item.data.pubDate} />
								</span>
							</a>
						))}
					</div>
				</section>
			)}

			<!-- Separate Waline Comments for this specific thought item -->
			<WalineComments path={`/thoughts/${thought.id}/`} />
		</main>
		<Footer />
	</body>
</html>
