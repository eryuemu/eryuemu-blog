---
import { getCollection } from 'astro:content';
import { Image } from 'astro:assets';
import BaseHead from '../components/BaseHead.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import FormattedDate from '../components/FormattedDate.astro';
import Splash from '../components/Splash.astro';
import ViewToggle from '../components/ViewToggle.astro';
import DefaultCover from '../components/DefaultCover.astro';
import avatar from '../assets/avatar.jpg';
import { SITE_TITLE, SITE_DESCRIPTION } from '../consts';

const posts = (await getCollection('blog'))
	.sort((a, b) => b.data.pubDate.valueOf() - a.data.pubDate.valueOf());
---

<!doctype html>
<html lang="zh-CN">
	<head>
		<BaseHead title={`二月木的个人博客 (${SITE_TITLE}) — 软硬件折腾与技术随笔`} description={SITE_DESCRIPTION} />
		<style>
			.hero {
				display: flex;
				align-items: center;
				gap: 3rem;
				padding: 4rem 0 3rem 0;
			}

			.hero-avatar-container {
				display: flex;
				flex-direction: column;
				align-items: center;
				gap: 0.8rem;
				flex-shrink: 0;
			}

			.hero-avatar {
				width: 130px;
				height: 130px;
				border-radius: 50%;
				object-fit: cover;
				border: 1px solid var(--border);
			}

			.hero-motto {
				font-size: 0.82rem;
				color: var(--text-muted);
				margin: 0;
				font-weight: 500;
				letter-spacing: 0.06em;
				white-space: nowrap;
			}

			.hero-content {
				flex: 1;
			}

			.hero-title {
				font-size: 2rem;
				font-weight: 700;
				line-height: 1.3;
				margin-bottom: 0.8rem;
				color: var(--text-primary);
			}

			.hero-desc {
				font-size: 1.05rem;
				color: var(--text-secondary);
				max-width: 560px;
				line-height: 1.7;
				margin-bottom: 1.5rem;
			}

			.hero-links {
				display: flex;
				gap: 1.5rem;
				align-items: center;
			}

			.hero-links a {
				font-size: 0.9rem;
				font-weight: 500;
				color: var(--text-primary);
				text-decoration: none;
				display: inline-flex;
				align-items: center;
				gap: 0.35rem;
			}

			.hero-links a:hover {
				opacity: 0.6;
			}

			.hero-links .arrow {
				transition: transform 0.2s ease;
			}

			.hero-links a:hover .arrow {
				transform: translateX(3px);
			}

			/* Section Header */
			.section-header {
				display: flex;
				justify-content: space-between;
				align-items: baseline;
				margin-bottom: 1.5rem;
				padding-bottom: 0.8rem;
				border-bottom: 1px solid var(--border);
			}

			.section-title {
				margin: 0;
				font-size: 1.1rem;
				font-weight: 600;
				color: var(--text-primary);
			}

			.header-controls {
				display: flex;
				align-items: center;
				gap: 0.75rem;
			}

			.view-all {
				font-size: 0.85rem;
				font-weight: 500;
				color: var(--text-muted);
				display: inline-flex;
				align-items: center;
				gap: 0.3rem;
				text-decoration: none;
			}

			.view-all:hover {
				color: var(--text-primary);
				opacity: 1;
			}

			/* Category Tabs */
			.category-tabs {
				display: flex;
				gap: 0.25rem;
				background: var(--bg-secondary);
				padding: 0.2rem;
				border-radius: 20px;
				border: 1px solid var(--border);
				align-self: center;
			}

			.tab-btn {
				background: transparent;
				border: 1px solid transparent;
				padding: 0.35rem 0.9rem;
				font-size: 0.82rem;
				font-weight: 500;
				color: var(--text-muted);
				border-radius: 16px;
				cursor: pointer;
				transition: all 0.25s cubic-bezier(0.16, 1, 0.3, 1);
			}

			.tab-btn:hover {
				color: var(--text-primary);
			}

			.tab-btn.active {
				background: var(--bg);
				color: var(--text-primary);
				border-color: var(--border);
				box-shadow: 0 2px 6px rgba(0, 0, 0, 0.04);
			}

			/* Container Animation */
			.posts-wrapper {
				transition: opacity 0.22s cubic-bezier(0.16, 1, 0.3, 1), transform 0.22s cubic-bezier(0.16, 1, 0.3, 1);
				will-change: opacity, transform;
			}

			.posts-wrapper.is-filtering {
				opacity: 0;
				transform: translateY(4px);
			}

			/* ─── 1. Original Minimal List View (100% Identical to Original) ─── */
			.posts-list-view {
				display: flex;
				flex-direction: column;
				gap: 0;
			}

			.posts-list-view .post-item {
				display: block;
			}

			.posts-list-view .post-item a {
				display: flex;
				align-items: baseline;
				gap: 1rem;
				padding: 1rem 0;
				border-bottom: 1px solid var(--border);
				text-decoration: none;
				transition: opacity 0.15s ease;
			}

			.posts-list-view .post-item:last-child a {
				border-bottom: none;
			}

			.posts-list-view .post-item a:hover {
				opacity: 0.6;
			}

			.posts-list-view .post-date {
				font-size: 0.85rem;
				color: var(--text-muted);
				white-space: nowrap;
				flex-shrink: 0;
				font-variant-numeric: tabular-nums;
				width: 8.8rem;
			}

			.posts-list-view .post-title-wrapper {
				display: inline-flex;
				align-items: center;
				gap: 0.5rem;
				flex: 1;
				min-width: 0;
			}

			.posts-list-view .post-title {
				font-size: 1rem;
				font-weight: 500;
				color: var(--text-primary);
				line-height: 1.4;
			}

			.type-badge-inline {
				font-size: 0.72rem;
				font-weight: 500;
				padding: 0.08rem 0.4rem;
				border-radius: 4px;
				line-height: 1.2;
				border: 1px solid var(--border);
				background: var(--bg-secondary);
				color: var(--text-muted);
				white-space: nowrap;
				flex-shrink: 0;
			}

			.type-badge-inline.is-original {
				color: var(--text-primary);
			}

			/* ─── 2. Persona-styled Card Grid View ─── */
			.posts-grid-view {
				display: grid;
				grid-template-columns: repeat(auto-fill, minmax(280px, 1fr));
				gap: 1.25rem;
				padding: 0.5rem 0 1rem 0;
			}

			.posts-grid-view .grid-card-item {
				background: var(--bg-secondary);
				border: 1px solid var(--border);
				border-radius: 12px;
				overflow: hidden;
				transition: transform 0.25s cubic-bezier(0.16, 1, 0.3, 1),
				            box-shadow 0.25s cubic-bezier(0.16, 1, 0.3, 1),
				            border-color 0.25s ease;
			}

			.posts-grid-view .grid-card-item:hover {
				transform: translateY(-3px);
				border-color: var(--border-hover);
				box-shadow: 0 10px 24px rgba(0, 0, 0, 0.06);
			}

			html.dark .posts-grid-view .grid-card-item:hover {
				box-shadow: 0 10px 24px rgba(0, 0, 0, 0.35);
			}

			.posts-grid-view .card-link {
				display: flex;
				flex-direction: column;
				height: 100%;
				text-decoration: none;
				color: inherit;
			}

			.posts-grid-view .card-cover {
				display: block;
				width: 100%;
				aspect-ratio: 16 / 9;
				overflow: hidden;
				position: relative;
				background: var(--bg);
				border-bottom: 1px solid var(--border);
			}

			.posts-grid-view .card-cover-img {
				width: 100%;
				height: 100%;
				object-fit: cover;
				transition: transform 0.4s cubic-bezier(0.16, 1, 0.3, 1);
			}

			.posts-grid-view .grid-card-item:hover .card-cover-img {
				transform: scale(1.04);
			}

			.posts-grid-view .card-body {
				padding: 1.2rem;
				display: flex;
				flex-direction: column;
				flex: 1;
				gap: 0.65rem;
			}

			.posts-grid-view .card-meta {
				display: flex;
				align-items: center;
				justify-content: space-between;
				width: 100%;
			}

			.posts-grid-view .card-date {
				font-size: 0.8rem;
				color: var(--text-muted);
				font-variant-numeric: tabular-nums;
			}

			.posts-grid-view .card-title {
				font-size: 1.05rem;
				font-weight: 600;
				color: var(--text-primary);
				line-height: 1.4;
				margin: 0;
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
			}

			.posts-grid-view .card-desc {
				display: -webkit-box;
				-webkit-line-clamp: 2;
				-webkit-box-orient: vertical;
				overflow: hidden;
				font-size: 0.88rem;
				color: var(--text-secondary);
				line-height: 1.55;
				margin: 0;
				opacity: 0.85;
			}

			@media (max-width: 768px) {
				.section-header {
					flex-direction: column;
					align-items: flex-start;
					gap: 0.8rem;
				}
				.header-controls {
					width: 100%;
					justify-content: space-between;
				}
				.category-tabs {
					width: 100%;
					box-sizing: border-box;
					justify-content: space-between;
				}
				.tab-btn {
					flex: 1;
					text-align: center;
				}
				.hero {
					flex-direction: column;
					align-items: flex-start;
					gap: 1.5rem;
					padding: 2.5rem 0 2rem 0;
				}
				.hero-avatar-container {
					align-items: flex-start;
					gap: 0.6rem;
				}
				.hero-avatar {
					width: 90px;
					height: 90px;
				}
				.hero-title {
					font-size: 1.6rem;
				}
				.hero-desc {
					font-size: 0.95rem;
				}
				.posts-list-view .post-item a {
					flex-direction: column;
					gap: 0.2rem;
				}
				.posts-list-view .post-date {
					width: auto;
				}
			}
		</style>
	</head>
	<body>
		<Splash />
		<Header />
		<main>
			<section class="hero">
				<div class="hero-avatar-container">
					<Image src={avatar} alt="eryuemu's avatar" class="hero-avatar" loading="eager" transition:name="hero-avatar" />
					<p class="hero-motto" transition:name="hero-motto">事在人为 圆融自洽</p>
				</div>
				<div class="hero-content">
					<h1 class="hero-title">你好，我是 <span class="hero-author-name" transition:name="hero-name">eryuemu（二月木）</span></h1>
					<p class="hero-desc">
						主修自动化专业。重度软硬件折腾控、赛博洁癖患者。这里记录了我折腾大模型、WSL2、eSIM、QQ 机器人、书法与二次元的日常。
					</p>
					<div class="hero-links">
						<a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/blog/`}>
							阅读文章 <span class="arrow">→</span>
						</a>
						<a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/projects/`}>我的项目</a>
						<a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/about/`}>关于我</a>
						<a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/about/#contact`}>联系我</a>
					</div>
				</div>
			</section>

			<section>
				<div class="section-header">
					<h2 class="section-title">近期文章</h2>
					<!-- Category Filter Tabs -->
					<div class="category-tabs" id="category-filter">
						<button class="tab-btn active" data-category="all">全部</button>
						<button class="tab-btn" data-category="开发">开发</button>
						<button class="tab-btn" data-category="随笔">随笔</button>
					</div>
					<div class="header-controls">
						<ViewToggle containerId="posts-wrapper" />
					</div>
					<a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/blog/`} class="view-all">全部 →</a>
				</div>

				<div class="posts-wrapper" id="posts-wrapper" data-view="list">
					<!-- 1. Original List View -->
					<div class="posts-list-view" id="posts-list-view">
						{
							posts.map((post) => (
								<article class="post-item" data-category={post.data.category || '开发'} data-type={post.data.type || 'ai-organized'}>
									<a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/blog/${post.id}/`}>
										<span class="post-date">
											<FormattedDate date={post.data.pubDate} includeTime={!post.data.hideTime} />
										</span>
										<span class="post-title-wrapper">
											<span class="post-title" data-vt-slug={post.id} transition:name={`post-title-${post.id}`}>{post.data.title}</span>
											<span class={`type-badge-inline ${post.data.type === 'original' ? 'is-original' : 'is-ai'}`}>
												{post.data.type === 'original' ? '原创' : 'AI 整理'}
											</span>
										</span>
									</a>
								</article>
							))
						}
					</div>

					<!-- 2. Persona 5 Styled Grid View -->
					<div class="posts-grid-view" id="posts-grid-view" style="display: none;">
						{
							posts.map((post, index) => (
								<article class="grid-card-item" data-category={post.data.category || '开发'} data-type={post.data.type || 'ai-organized'}>
									<a href={`${import.meta.env.BASE_URL.replace(/\/$/, '')}/blog/${post.id}/`} class="card-link">
										<div class="card-cover">
											{post.data.heroImage ? (
												<Image src={post.data.heroImage} alt={post.data.title} class="card-cover-img" width={600} height={337} format="webp" data-vt-slug={post.id} transition:name={`post-cover-${post.id}`} />
											) : (
												<DefaultCover title={post.data.title} category={post.data.category} type={post.data.type} index={index + 1} />
											)}
										</div>
										<div class="card-body">
											<div class="card-meta">
												<span class="card-date">
													<FormattedDate date={post.data.pubDate} includeTime={!post.data.hideTime} />
												</span>
												<span class={`type-badge-inline ${post.data.type === 'original' ? 'is-original' : 'is-ai'}`}>
													{post.data.type === 'original' ? '原创' : 'AI 整理'}
												</span>
											</div>
											<h3 class="card-title">{post.data.title}</h3>
											<p class="card-desc">{post.data.description}</p>
										</div>
									</a>
								</article>
							))
						}
					</div>
				</div>
			</section>
		</main>
		<Footer />

		<script>
			function setupCategoryFilterAndViewToggle() {
				const STORAGE_KEY = 'eryuemu_blog_view_mode';
				const filterContainer = document.getElementById('category-filter');
				const wrapper = document.getElementById('posts-wrapper');
				const listView = document.getElementById('posts-list-view');
				const gridView = document.getElementById('posts-grid-view');

				const listItems = listView ? listView.querySelectorAll('.post-item') : [];
				const gridItems = gridView ? gridView.querySelectorAll('.grid-card-item') : [];

				// 1. Category Filter Logic
				if (filterContainer) {
					const buttons = filterContainer.querySelectorAll('.tab-btn');

					function applyFilter(selectedCategory: string | null) {
						let listVisible = 0;
						listItems.forEach(post => {
							const postCategory = post.getAttribute('data-category');
							if (selectedCategory === 'all' || postCategory === selectedCategory) {
								if (listVisible < 12) {
									(post as HTMLElement).style.display = 'block';
									listVisible++;
								} else {
									(post as HTMLElement).style.display = 'none';
								}
							} else {
								(post as HTMLElement).style.display = 'none';
							}
						});

						let gridVisible = 0;
						gridItems.forEach(post => {
							const postCategory = post.getAttribute('data-category');
							if (selectedCategory === 'all' || postCategory === selectedCategory) {
								if (gridVisible < 12) {
									(post as HTMLElement).style.display = 'flex';
									gridVisible++;
								} else {
									(post as HTMLElement).style.display = 'none';
								}
							} else {
								(post as HTMLElement).style.display = 'none';
							}
						});
					}

					buttons.forEach(btn => {
						btn.addEventListener('click', () => {
							if (btn.classList.contains('active')) return;

							buttons.forEach(b => b.classList.remove('active'));
							btn.classList.add('active');

							const selectedCategory = btn.getAttribute('data-category');

							if (wrapper) {
								wrapper.classList.add('is-filtering');
								setTimeout(() => {
									applyFilter(selectedCategory);
									wrapper.classList.remove('is-filtering');
								}, 160);
							} else {
								applyFilter(selectedCategory);
							}
						});
					});

					const activeBtn = filterContainer.querySelector('.tab-btn.active');
					if (activeBtn) {
						applyFilter(activeBtn.getAttribute('data-category'));
					}
				}

				// 2. View Switcher Toggle Logic
				const toggleWrappers = document.querySelectorAll('.view-toggle-wrapper');
				const savedView = localStorage.getItem(STORAGE_KEY) || 'list';

				function setViewMode(mode: 'list' | 'grid') {
					localStorage.setItem(STORAGE_KEY, mode);
					if (wrapper) wrapper.setAttribute('data-view', mode);

					if (mode === 'grid') {
						if (listView) listView.style.display = 'none';
						if (gridView) gridView.style.display = 'grid';
					} else {
						if (listView) listView.style.display = 'flex';
						if (gridView) gridView.style.display = 'none';
					}

					toggleWrappers.forEach(tw => {
						const btns = tw.querySelectorAll('.view-btn');
						btns.forEach(btn => {
							if (btn.getAttribute('data-view') === mode) {
								btn.classList.add('active');
							} else {
								btn.classList.remove('active');
							}
						});
					});
				}

				toggleWrappers.forEach(tw => {
					const btns = tw.querySelectorAll('.view-btn');
					btns.forEach(btn => {
						btn.addEventListener('click', () => {
							const selectedMode = btn.getAttribute('data-view') as 'list' | 'grid';
							if (selectedMode) {
								setViewMode(selectedMode);
							}
						});
					});
				});

				setViewMode(savedView as 'list' | 'grid');
			}

			document.addEventListener('astro:page-load', setupCategoryFilterAndViewToggle);
		</script>
	</body>
</html>
