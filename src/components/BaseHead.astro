---
// Import the global.css file here so that it is included on
// all pages through the use of the <BaseHead /> component.
import '../styles/global.css';
import type { ImageMetadata } from 'astro';
import FallbackImage from '../assets/avatar.jpg';
import { SITE_TITLE, SITE_DESCRIPTION, UMAMI_WEBSITE_ID } from '../consts';
import { Font } from 'astro:assets';
import { ClientRouter } from 'astro:transitions';

interface Props {
	title: string;
	description: string;
	image?: ImageMetadata;
}

const canonicalURL = new URL(Astro.url.pathname, Astro.site);

const { title, description, image = FallbackImage } = Astro.props;
---

<!-- Global Metadata -->
<meta charset="utf-8" />
<meta name="viewport" content="width=device-width,initial-scale=1" />
<meta name="google-site-verification" content="Fw3HQbD2gcqVAUjGkjV06KSo3fotAb0DGPwZS8y4rEU" />
<meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
<link rel="icon" type="image/jpeg" href="/avatar.jpg" />
<link rel="sitemap" href="/sitemap-index.xml" />
<link
	rel="alternate"
	type="application/rss+xml"
	title={SITE_TITLE}
	href={new URL('rss.xml', Astro.site)}
/>
<meta name="generator" content={Astro.generator} />

<!-- Umami Analytics -->
{UMAMI_WEBSITE_ID && (
	<script
		defer
		src="https://cloud.umami.is/script.js"
		data-website-id={UMAMI_WEBSITE_ID}
	></script>
)}


<Font cssVariable="--font-atkinson" preload />

<!-- Canonical URL -->
<link rel="canonical" href={canonicalURL} />

<!--
  Force Astro's own View Transition on back/forward navigation.
  Chromium may offer a *native* history-navigation transition: when it does, the
  `popstate` event reports hasUAVisualTransition=true and Astro's ClientRouter
  deliberately skips `document.startViewTransition()`, which also skips every
  shared-element morph (avatar / name / motto / title) on the way Back.
  Re-declaring the getter to `false` makes Astro always run its own transition.
-->
<script is:inline>
	try {
		Object.defineProperty(PopStateEvent.prototype, 'hasUAVisualTransition', {
			get() {
				return false;
			},
			configurable: true,
		});
	} catch {}
</script>

<ClientRouter />

<!--
  Firefox compatibility: Firefox skips the *entire* View Transition when the
  incoming page carries many "new-only" shared elements (view-transition-names
  that did not exist on the outgoing page). The homepage / blog list declares
  one `post-title-<slug>` / `post-cover-<slug>` name per post (28 + 6), so any
  transition INTO those pages (e.g. article → home) gets swallowed and even the
  hero avatar/name/motto fly-back disappears.

<!--
  Shared-Element Isolation:
  Collapses per-post shared elements to *one* active article at a time.
  When entering an article or returning to the list, only that specific article's
  post-title-<slug> / post-cover-<slug> is activated, while the remaining 30+ items
  have viewTransitionName = 'none'.
  This guarantees that 100% of GPU compositor resources focus on the single active
  title/cover, avoiding dropped frames, animation clipping, or skipped morphs.
-->
<script>
	const getArticleSlug = (doc = document) => {
		const h1 = doc ? doc.querySelector('h1[data-vt-slug]') : null;
		if (h1) return h1.getAttribute('data-vt-slug');
		const m = window.location.pathname.match(/\/blog\/([^\/]+)\//);
		return m ? decodeURIComponent(m[1]) : null;
	};

	function applyPostVT(root, activeSlug) {
		if (!root) return;
		root.querySelectorAll('[data-vt-slug]').forEach((el) => {
			const slug = el.getAttribute('data-vt-slug');
			if (activeSlug !== null && activeSlug !== undefined && slug === activeSlug) {
				const isTitle = el.tagName === 'H1' || el.tagName === 'H2' || el.classList.contains('post-title');
				el.style.viewTransitionName = isTitle ? 'active-post-title' : 'active-post-cover';
			} else {
				// Disable non-target articles so only 1 shared element pair exists
				el.style.viewTransitionName = 'none';
			}
		});
	}

	// Re-apply the user's list/grid + category + AI filter on the INCOMING
	// document BEFORE the browser captures the new page. The server HTML ships
	// defaults (list view, category 全部) — e.g. the grid is rendered with
	// display:none and AI visibility only applies once html[data-show-ai] is
	// set. Capturing those defaults breaks every shared-element pair on the
	// way back (no title/cover box -> no morph in 卡片 or 分类/AI 筛选 views).
	function restoreViewState(doc) {
		if (!doc || !doc.documentElement) return;
		const showAi = localStorage.getItem('eryuemu_blog_show_ai') === 'true';
		doc.documentElement.setAttribute('data-show-ai', showAi ? 'true' : 'false');
		const mode = localStorage.getItem('eryuemu_blog_view_mode') || 'list';
		const list = doc.getElementById('blog-posts-list') || doc.getElementById('posts-list-view');
		const grid = doc.getElementById('blog-posts-grid') || doc.getElementById('posts-grid-view');
		if (mode === 'grid' && list && grid) {
			list.style.display = 'none';
			grid.style.display = 'grid';
		}
		const cat = sessionStorage.getItem('eryuemu_blog_category') || 'all';

		// Sync active class on tab and filter buttons in the incoming document
		doc.querySelectorAll('.tab-btn').forEach((btn) => {
			btn.classList.toggle('active', btn.getAttribute('data-category') === cat);
		});
		doc.querySelectorAll('.view-btn').forEach((btn) => {
			btn.classList.toggle('active', btn.getAttribute('data-view') === mode);
		});
		doc.querySelectorAll('.ai-filter-btn').forEach((btn) => {
			btn.classList.toggle('active', (btn.getAttribute('data-show-ai') === 'true') === showAi);
		});

		const isHome = doc.getElementById('posts-wrapper') !== null;
		let homeListCount = 0;
		let homeGridCount = 0;
		doc.querySelectorAll('.post-item, .grid-card-item').forEach((el) => {
			const c = el.getAttribute('data-category') || '开发';
			const t = el.getAttribute('data-type') || 'ai-organized';
			const ok = (cat === 'all' || c === cat) && (showAi || t === 'original');
			if (isHome) {
				const isGrid = el.classList.contains('grid-card-item');
				if (isGrid) {
					el.style.display = (ok && homeGridCount < 12) ? 'flex' : 'none';
					if (ok) homeGridCount++;
				} else {
					el.style.display = (ok && homeListCount < 12) ? 'block' : 'none';
					if (ok) homeListCount++;
				}
			} else {
				el.style.display = ok ? '' : 'none';
			}
		});
	}

	let targetSlug = null;

	// When leaving an article, snap it back to top BEFORE Astro captures the
	// outgoing snapshot. The shared title sits at the top of the article, so if
	// the reader has scrolled down (natural while reading), the outgoing title
	// would be captured offscreen and the shared-element morph would start
	// invisible — breaking the one-shot title flight on the way back.
	const snapArticleToTop = () => {
		if (getArticleSlug(document)) {
			window.scrollTo(0, 0);
		}
	};

	// Capture click to lock in target slug when clicking an article link
	document.addEventListener(
		'click',
		(e) => {
			const a = e.target instanceof Element ? e.target.closest('a') : null;
			if (!a) return;
			const m = (a.href || '').match(/\/blog\/([^\/]+)\//);
			targetSlug = m ? decodeURIComponent(m[1]) : getArticleSlug(document);
			applyPostVT(document, targetSlug);
			// Same-origin links the router will actually handle (not new tabs,
			// not external): make sure the snapshot sees the article top.
			if (!m && !a.target && (a.href || '').startsWith(location.origin)) {
				snapArticleToTop();
			}
		},
		true
	);

	// Browser Back from a scrolled article: same offscreen-capture problem.
	// Runs before Astro's snapshot (the fetch delays startViewTransition).
	window.addEventListener('popstate', () => {
		snapArticleToTop();
	});

	// Before DOM swap, if targetSlug wasn't set by click (e.g. browser Back button),
	// read the slug from the article page we are currently leaving in document!
	document.addEventListener('astro:before-swap', (e) => {
		if (!targetSlug) {
			targetSlug = getArticleSlug(document);
		}
		applyPostVT(document, targetSlug);
		applyPostVT(e.newDocument, targetSlug);
		restoreViewState(e.newDocument);
	});

	// The browser captures the incoming page right after the swap callback
	// resolves. `astro:after-swap` fires synchronously inside that callback
	// (well before the capture in both Chromium and Firefox), so re-asserting
	// the activation here makes the shared name deterministically present in
	// the new-state snapshot — no reliance on microtask timing races.
	document.addEventListener('astro:after-swap', () => {
		applyPostVT(document, targetSlug);
	});

	// Sync current page on initial load and after navigation
	function syncPostVT() {
		// Preserve the slug locked in by the click / astro:before-swap handlers.
		// `astro:page-load` can fire BEFORE the browser captures the incoming page
		// during a View Transition, so re-deriving the slug from THIS page here
		// would un-name the incoming title (list pages have no h1[data-vt-slug])
		// and silently kill the shared-element morph on browser Back / back-btn.
		if (targetSlug == null) {
			targetSlug = getArticleSlug(document);
		}
		applyPostVT(document, targetSlug);
	}

	syncPostVT();
	document.addEventListener('astro:page-load', syncPostVT);
</script>

<!-- Theme & Filter Preferences Setup Script -->
<script is:inline>
	const getTheme = () => {
		if (typeof localStorage !== 'undefined' && localStorage.getItem('theme')) {
			return localStorage.getItem('theme');
		}
		if (window.matchMedia('(prefers-color-scheme: dark)').matches) {
			return 'dark';
		}
		return 'light';
	};
	
	if (getTheme() === 'dark') {
		document.documentElement.classList.add('dark');
	} else {
		document.documentElement.classList.remove('dark');
	}

	// Synchronize AI filter visibility preference before view transitions render
	const syncAiFilterAttr = (doc) => {
		const showAi = typeof localStorage !== 'undefined' && localStorage.getItem('eryuemu_blog_show_ai') === 'true';
		doc.documentElement.setAttribute('data-show-ai', showAi ? 'true' : 'false');
	};

	syncAiFilterAttr(document);

	document.addEventListener('astro:before-swap', (e) => {
		syncAiFilterAttr(e.newDocument);
		if (localStorage.getItem('theme') === 'dark') {
			e.newDocument.documentElement.classList.add('dark');
		} else {
			e.newDocument.documentElement.classList.remove('dark');
		}
	});

	document.addEventListener('astro:after-swap', () => {
		if (localStorage.getItem('theme') === 'dark') {
			document.documentElement.classList.add('dark');
		} else {
			document.documentElement.classList.remove('dark');
		}
	});
</script>

<!-- Primary Meta Tags -->
<title>{title}</title>
<meta name="description" content={description} />

<!-- Tencent QQ / WeChat Meta Tags -->
<meta itemprop="name" content={title} />
<meta itemprop="description" content={description} />
<meta itemprop="image" content={new URL(image.src, Astro.url)} />

<!-- Open Graph / Facebook -->
<meta property="og:type" content="website" />
<meta property="og:url" content={Astro.url} />
<meta property="og:title" content={title} />
<meta property="og:description" content={description} />
<meta property="og:image" content={new URL(image.src, Astro.url)} />
<meta property="og:locale" content="zh_CN" />
<meta property="og:site_name" content={SITE_TITLE} />

<!-- Twitter -->
<meta name="twitter:card" content="summary_large_image" />
<meta name="twitter:url" content={Astro.url} />
<meta name="twitter:title" content={title} />
<meta name="twitter:description" content={description} />
<meta name="twitter:image" content={new URL(image.src, Astro.url)} />

<!-- JSON-LD Structured Data -->
<script type="application/ld+json" set:html={JSON.stringify({
  "@context": "https://schema.org",
  "@graph": [
    {
      "@type": "WebSite",
      "name": SITE_TITLE,
      "url": "https://eryuemu.com",
      "description": SITE_DESCRIPTION,
      "inLanguage": "zh-CN",
      "author": {
        "@type": "Person",
        "name": "eryuemu",
        "url": "https://eryuemu.com/about"
      }
    },
    {
      "@type": "SiteNavigationElement",
      "name": ["首页", "文章", "项目", "心迹", "友链", "关于"],
      "url": [
        "https://eryuemu.com/",
        "https://eryuemu.com/blog/",
        "https://eryuemu.com/projects/",
        "https://eryuemu.com/thoughts/",
        "https://eryuemu.com/friends/",
        "https://eryuemu.com/about/"
      ]
    }
  ]
})} />
